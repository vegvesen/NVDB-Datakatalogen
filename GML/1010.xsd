   <complexType name="Fortøyningsinnretning (test)Type">
      <complexContent>
         <extension base="gml:AbstractFeatureType">
            <sequence>
               <element name="type" type="nvdb:TypeFortøyningsinnretning (test)Type">
                  <annotation>
