<?xml version="1.0" encoding="UTF-8"?>
<PropertySetDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="http://standards.buildingsmart.org/IFC/RELEASE/IFC4/FINAL/PSD/PSD_IFC4.xsd">
   <IfcVersion/>
   <Name>Pset_NVDB_FARTSGRENSE</Name>
   <Applicability/>
   <ApplicableClasses/>
   <ApplicableTypeValue/>
   <PropertyDefs>
      <PropertyDef>
         <Name>fartsgrenseVerdi</Name>
         <Definition>Høyeste tillatte hastighet på en vegstrekning.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fartsgrense_FartsgrenseVerdi">
                  <EnumItem>100</EnumItem>
                  <EnumItem>110</EnumItem>
                  <EnumItem>120</EnumItem>
                  <EnumItem>20</EnumItem>
                  <EnumItem>30</EnumItem>
                  <EnumItem>40</EnumItem>
                  <EnumItem>5</EnumItem>
                  <EnumItem>50</EnumItem>
                  <EnumItem>60</EnumItem>
                  <EnumItem>70</EnumItem>
                  <EnumItem>80</EnumItem>
                  <EnumItem>90</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedtaksnummer</Name>
         <Definition>Angir vedtaksnummer.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>gyldigFraDato</Name>
         <Definition>Dato for når fartsgrense ble satt i drift. Den dato skiltene ble "avduket".</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcDateTime"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>arkivnummer</Name>
         <Definition>Gir referanse til relevant sak i vegeiers arkivsystem.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>merknad</Name>
         <Definition/>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fartsgrense_Merknad">
                  <EnumItem>Privat adkomst</EnumItem>
                  <EnumItem>Privat skiltet</EnumItem>
                  <EnumItem>Privat veg innenfor fartsgrensesone</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedtaksdato</Name>
         <Definition>Angir dato for når vedtaket ble fattet</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcDateTime"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>variabelFartsgrense</Name>
         <Definition>Angir om fartsgrensen er variabel eller ikke</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fartsgrense_VariabelFartsgrense">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tidsbegrensning</Name>
         <Definition>Angir tidsrom som vegobjektet er gyldig. Tidsrom innenfor et døgn fartsgrense er gyldig f.eks 06:00-20:00</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>VDB_id</Name>
         <Definition>Gir objektets id i VDB</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
   </PropertyDefs>
</PropertySetDef>
