<?xml version="1.0" encoding="UTF-8"?>
<PropertySetDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="http://standards.buildingsmart.org/IFC/RELEASE/IFC4/FINAL/PSD/PSD_IFC4.xsd">
   <IfcVersion/>
   <Name>Pset_NVDB_FISKEPASSASJE</Name>
   <Applicability/>
   <ApplicableClasses/>
   <ApplicableTypeValue/>
   <PropertyDefs>
      <PropertyDef>
         <Name>lokalitetsnavn</Name>
         <Definition>VannforekomstID skal benyttes der det finnes, og navn fra Vann-nett og navn fra SSR kan benyttes. F.eks. "Vømmøla - 777- 777-R".</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>type</Name>
         <Definition>Angir hvilken type utforming passasjen har.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Type">
                  <EnumItem>Bru</EnumItem>
                  <EnumItem>Kulvert</EnumItem>
                  <EnumItem>Stikkrenne</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>beskrivelse</Name>
         <Definition>Beskrivelse av fiskepassasjen og område rundt, referanser til undersøkelser, saksarkiv m.m.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vandringshinder</Name>
         <Definition>Angir om passasje er vandringshindrende for fisk og ferskvannsorganismer.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Vandringshinder">
                  <EnumItem>Sperre, nær absolutt hinder</EnumItem>
                  <EnumItem>Ukjent</EnumItem>
                  <EnumItem>Vandring påvirkes ikke eller kun i beskjeden grad</EnumItem>
                  <EnumItem>Vandring påvirkes, delvis hinder</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>beskrivelseVandringshinder</Name>
         <Definition>Beskrive hva som forårsaker vandringshinder; Høydeforskjell ved utløp, mangler kulp nedstrøms, vannhastighet, hinder eller gitter ved inntak, annet.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tiltaksbehovPrioritering</Name>
         <Definition>Vegeiers egen prioritering av tiltak for denne fiskepassasjen.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_TiltaksbehovPrioritering">
                  <EnumItem>1</EnumItem>
                  <EnumItem>2</EnumItem>
                  <EnumItem>3</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>bunnsubstrat</Name>
         <Definition>Beskrivelse av bunnsubstrat i fiskepassasjen.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Bunnsubstrat">
                  <EnumItem>Naturlig</EnumItem>
                  <EnumItem>Naturlik</EnumItem>
                  <EnumItem>Unaturlig</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tiltakstype</Name>
         <Definition>Hovedtiltak for å sikre fiskens frie vandring. Øvrige tiltak beskrives i egenskapstype "Beskrivelse tiltak" (13345).</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Tiltakstype">
                  <EnumItem>Annet</EnumItem>
                  <EnumItem>Betongterskler, plasstøpt</EnumItem>
                  <EnumItem>Betongterskler, prefabrikert</EnumItem>
                  <EnumItem>Fisketrapp</EnumItem>
                  <EnumItem>Fleksiterskler</EnumItem>
                  <EnumItem>Ospestokker</EnumItem>
                  <EnumItem>Terskler nedstrøms</EnumItem>
                  <EnumItem>Utlegging av substrat</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>statusTiltak</Name>
         <Definition>Angir status for tiltak.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_StatusTiltak">
                  <EnumItem>Ikke utført</EnumItem>
                  <EnumItem>Utført</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>beskrivelseTiltak</Name>
         <Definition>Opplisting av både hovedtiltak og øvrige tiltak.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>brutus_Id</Name>
         <Definition>Gir referanse til brudatabanken.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tiltaksår</Name>
         <Definition>Angir hvilket år det ble gjennomført tiltak for å sikre fiskens frie vandring.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>befaringsår</Name>
         <Definition>Angir hvilket år det ble sist gjennomført befaring og vurdering av fiskepassasjens tilstand.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>eier</Name>
         <Definition>Angir hvem som er eier av vegobjektet.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Eier">
                  <EnumItem>Fylkeskommune</EnumItem>
                  <EnumItem>Kommune</EnumItem>
                  <EnumItem>Privat</EnumItem>
                  <EnumItem>Stat, Nye Veier</EnumItem>
                  <EnumItem>Stat, Statens vegvesen</EnumItem>
                  <EnumItem>Uavklart</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedlikeholdsansvarlig</Name>
         <Definition>Angir hvem som er ansvarlig for vedlikehold av vegobjektet.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Fiskepassasje_Vedlikeholdsansvarlig">
                  <EnumItem>Fylkeskommune</EnumItem>
                  <EnumItem>Kommune</EnumItem>
                  <EnumItem>Nye Veier</EnumItem>
                  <EnumItem>OPS</EnumItem>
                  <EnumItem>Privat</EnumItem>
                  <EnumItem>Statens vegvesen</EnumItem>
                  <EnumItem>Uavklart</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
   </PropertyDefs>
</PropertySetDef>
