<?xml version="1.0" encoding="UTF-8"?>
<PropertySetDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="http://standards.buildingsmart.org/IFC/RELEASE/IFC4/FINAL/PSD/PSD_IFC4.xsd">
   <IfcVersion/>
   <Name>Pset_NVDB_KANTKLIPPAREAL</Name>
   <Applicability/>
   <ApplicableClasses/>
   <ApplicableTypeValue/>
   <PropertyDefs>
      <PropertyDef>
         <Name>klippebredde_Faktisk</Name>
         <Definition>Angir skrå bredde på området som faktisk skal klippes.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>klippebredde_Kvalitet</Name>
         <Definition>Angir kvalitet på verdier for "Klippebredde, faktisk" og ev. "Klippebredde, krav".</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_Klippebredde_Kvalitet">
                  <EnumItem>Basert på generelle krav</EnumItem>
                  <EnumItem>Generelt anslag</EnumItem>
                  <EnumItem>Målt i felt</EnumItem>
                  <EnumItem>Vurdert i felt</EnumItem>
                  <EnumItem>Vurdert ut fra vegbilder/flyfoto/kart </EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>kantklipp_AnbefaltIntervall</Name>
         <Definition>Gir anbefaling for hvor ofte det bør foretas kantklipp.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_Kantklipp_AnbefaltIntervall">
                  <EnumItem>1 g. pr år</EnumItem>
                  <EnumItem>2 g. pr år</EnumItem>
                  <EnumItem>2.hvert år</EnumItem>
                  <EnumItem>3-5. hvert år</EnumItem>
                  <EnumItem>1 g. pr år, e. 10/8</EnumItem>
                  <EnumItem>1 g. pr år, f. 10/6</EnumItem>
                  <EnumItem>2 g. pr. år f. 10/6 og e. 10/8</EnumItem>
                  <EnumItem>2.hvert år e. 10/8</EnumItem>
                  <EnumItem>2.hvert år f. 10/6</EnumItem>
                  <EnumItem>2.hvert år f. 10/6 og e. 10/8</EnumItem>
                  <EnumItem>2.hvert år, 2g</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>areal</Name>
         <Definition>Angir areal av vegobjekttype.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>klippebredde_Krav</Name>
         <Definition>Angir hvor langt ut fra vegkant, målt horisontalt, det er krav om å klippe.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>spesielleHensyn</Name>
         <Definition>Angir om det må tas spesielle hensyn i forbindelse med kantslått. Informasjon om dette skal legges under Tilleggsinformasjon (ET 11404)</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_SpesielleHensyn">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tilleggsinformasjon</Name>
         <Definition>Supplerende informasjon som har betydning for kantklipp.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>prosjektreferanse</Name>
         <Definition>Referanse til prosjekt. Det benyttes samme prosjektreferanse som på tilhørende Veganlegg (VT30). Benyttes for lettere å kunne skille nye data fra eksisterende data i NVDB.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>eier</Name>
         <Definition>Angir hvem som er eier av vegobjektet.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_Eier">
                  <EnumItem>Fylkeskommune</EnumItem>
                  <EnumItem>Kommune</EnumItem>
                  <EnumItem>Privat</EnumItem>
                  <EnumItem>Stat, Nye Veier</EnumItem>
                  <EnumItem>Stat, Statens vegvesen</EnumItem>
                  <EnumItem>Uavklart</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedlikeholdsansvarlig</Name>
         <Definition>Angir hvem som er ansvarlig for vedlikehold av vegobjektet.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_Vedlikeholdsansvarlig">
                  <EnumItem>Fylkeskommune</EnumItem>
                  <EnumItem>Kommune</EnumItem>
                  <EnumItem>Nye Veier</EnumItem>
                  <EnumItem>OPS</EnumItem>
                  <EnumItem>Privat</EnumItem>
                  <EnumItem>Statens vegvesen</EnumItem>
                  <EnumItem>Uavklart</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>typeVegkant</Name>
         <Definition>Angir hvilken type vegkant det er tale om. Gir informasjon om jordsmonn.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Kantklippareal_TypeVegkant">
                  <EnumItem>Fjellskjæringsvegkant</EnumItem>
                  <EnumItem>Friskengvegkant</EnumItem>
                  <EnumItem>Grusfyllingsvegkant</EnumItem>
                  <EnumItem>Lyngheivegkant</EnumItem>
                  <EnumItem>Myr-/ torvengvegkant</EnumItem>
                  <EnumItem>Nitrogenvegkant</EnumItem>
                  <EnumItem>Skogsengvegkant</EnumItem>
                  <EnumItem>Tørrengvegkant</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>1SlåttUtførtDato</Name>
         <Definition>Angir dato da 1. Slått sist ble utført. Dette feltet benyttes også for å angi dato for utført slått når det skal slåes 2. hvert år.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcDateTime"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>2SlåttUtførtDato</Name>
         <Definition>Angir dato da 2. Slått sist ble utført.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcDateTime"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>utgått_Prosjektreferanse</Name>
         <Definition>Referanse til prosjekt. Det benyttes samme prosjektreferanse som på tilhørende Veganlegg (VT30). Benyttes for lettere å kunne skille nye data fra eksisterende data i NVDB.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>VDB_id</Name>
         <Definition>Gir objektets id i VDB</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
   </PropertyDefs>
</PropertySetDef>
