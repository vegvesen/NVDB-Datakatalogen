<?xml version="1.0" encoding="UTF-8"?>
<PropertySetDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="http://standards.buildingsmart.org/IFC/RELEASE/IFC4/FINAL/PSD/PSD_IFC4.xsd">
   <IfcVersion/>
   <Name>Pset_NVDB_SYKKELRUTE_HOVEDNETTBYTETTSTED</Name>
   <Applicability/>
   <ApplicableClasses/>
   <ApplicableTypeValue/>
   <PropertyDefs>
      <PropertyDef>
         <Name>rutenavn</Name>
         <Definition>Navn på ruta.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>rutenummer</Name>
         <Definition>Identifikasjonsnummer eller betegnelse på ruta.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>skiltet</Name>
         <Definition>Angir om sykkelrute er skiltet eller ikke.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Skiltet">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tilleggsinformasjon</Name>
         <Definition>Supplerende informasjon om vegobjektet som ikke framkommer direkte av andre egenskapstyper.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>spesialSykkelrutetype</Name>
         <Definition>Rute som er definert ut fra spesiell tilrettelegging, spesielle bruksformål eller historisk opprinnelse.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_SpesialSykkelrutetype">
                  <EnumItem>Annet</EnumItem>
                  <EnumItem>Terrengsykling</EnumItem>
                  <EnumItem>Transportsykling</EnumItem>
                  <EnumItem>Tursykling</EnumItem>
                  <EnumItem>Utforsykling</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>gradering</Name>
         <Definition>Angivelse av hvor krevende ruta er, basert på forholdsvis objektive kriterier som underlag, tekniske utfordringer, høydemeter og stigningsgrad/eksponering. For mer informasjon, se kapitel om Gradering i Merkehåndboka (www.merkehandboka.no).</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Gradering">
                  <EnumItem>Ekspert</EnumItem>
                  <EnumItem>Enkel</EnumItem>
                  <EnumItem>Ikke gradert</EnumItem>
                  <EnumItem>Krevende</EnumItem>
                  <EnumItem>Middels</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>rutetype</Name>
         <Definition>Angivelse av type rute i et differensiert nett.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Rutetype">
                  <EnumItem>Forgreiningsrute</EnumItem>
                  <EnumItem>Hovedrute</EnumItem>
                  <EnumItem>Materute</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>rutebetydning</Name>
         <Definition>Klassifisering av tur- og friluftsruter etter hvor brukerne i hovedsak kommer fra. Klassifisering vurderes av "Vedlikeholdsansvarlig" og defineres ut fra bruken av ruta</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Rutebetydning">
                  <EnumItem>Lokal betydning</EnumItem>
                  <EnumItem>Nasjonal betydning</EnumItem>
                  <EnumItem>Regional betydning</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>merking</Name>
         <Definition>Forteller om det er merking langs en sti, løype, veg, sykkelveg mv. Med merking menes markering for å vise veg.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Merking">
                  <EnumItem>Ikke merket</EnumItem>
                  <EnumItem>Merket</EnumItem>
                  <EnumItem>Sesongmerket</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>anleggsnummer</Name>
         <Definition>Anleggsnummer i idrettsanleggsregisteret gitt i forbindelse med tilskudd gjennom spillemiddelordningen.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>UUKoblingsID</Name>
         <Definition>Identifikator for kobling mot data fra kartlegging av Universel Utforming.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>underlagstype</Name>
         <Definition>Type underlag som ruta eller løypa følger - om rutestrekningen har asfalt/betongdekke, går på grus eller på naturlig grunn.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Underlagstype">
                  <EnumItem>Annet underlag</EnumItem>
                  <EnumItem>Asfalt/betong</EnumItem>
                  <EnumItem>Grus</EnumItem>
                  <EnumItem>Naturlig grunn</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>rutebredde</Name>
         <Definition>Minste sti-, sykkelsti- eller skiløypebredde i grunnriss på rutestrekningen. </Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Rutebredde">
                  <EnumItem>0 til 0,5 meter</EnumItem>
                  <EnumItem>0,5 opptil 1,5 meter</EnumItem>
                  <EnumItem>1,5 opptil 3 meter</EnumItem>
                  <EnumItem>3 til 6 meter</EnumItem>
                  <EnumItem>over 6 meter</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>trafikkbelastning</Name>
         <Definition>Grov kategorisering av trafikkbelastning på en strekning.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Trafikkbelastning">
                  <EnumItem>Høy trafikkbelastning</EnumItem>
                  <EnumItem>Lav trafikkbelastning</EnumItem>
                  <EnumItem>Noe trafikkbelastning</EnumItem>
                  <EnumItem>Noe trafikkbelastning, sykkelfelt på vegen</EnumItem>
                  <EnumItem>Uten motoriert ferdsel</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>belysning</Name>
         <Definition>Om det er belysning eller ikke langs ruten. For eksempel lysløype registreres med egenskapen Belysning og verdien JA.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcBoolean"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>sesong</Name>
         <Definition>Tilrettelagt for sommer, vinter eller hele året.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Sykkelrute, hovednett bytettsted_Sesong">
                  <EnumItem>Helårs</EnumItem>
                  <EnumItem>Sommer</EnumItem>
                  <EnumItem>Vinter</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedlikeholdsansvarlig</Name>
         <Definition>Organisasjon/lag/forening, kommune, friluftsråd, reiselivsaktør eller andre som har ansvar for vedlikehold og/eller fremkommelighet av rute.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
   </PropertyDefs>
</PropertySetDef>
