<?xml version="1.0" encoding="UTF-8"?>
<PropertySetDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="http://standards.buildingsmart.org/IFC/RELEASE/IFC4/FINAL/PSD/PSD_IFC4.xsd">
   <IfcVersion/>
   <Name>Pset_NVDB_TUNNELLØP</Name>
   <Applicability/>
   <ApplicableClasses/>
   <ApplicableTypeValue/>
   <PropertyDefs>
      <PropertyDef>
         <Name>navn</Name>
         <Definition>Angir navn på tunnelløp.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>kategori</Name>
         <Definition>Angir hvilken kategori tunnelløpet tilhører.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_Kategori">
                  <EnumItem>Hovedløp</EnumItem>
                  <EnumItem>Rampe</EnumItem>
                  <EnumItem>Rundkjøring</EnumItem>
                  <EnumItem>Sekundærløp</EnumItem>
                  <EnumItem>Rømningsløp</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>tunnelprofil</Name>
         <Definition>Angir hvilket standard tunnelprofil tunnelløpet er bygd etter. Merknad: Dersom tunnelløpet har varierende standard, skal det oppgis det profilet som beskriver det minste tverrsnittet.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_Tunnelprofil">
                  <EnumItem>Rektangulært tverrsnitt</EnumItem>
                  <EnumItem>T10</EnumItem>
                  <EnumItem>T10,5</EnumItem>
                  <EnumItem>T11</EnumItem>
                  <EnumItem>T11,5</EnumItem>
                  <EnumItem>T12</EnumItem>
                  <EnumItem>T12,5</EnumItem>
                  <EnumItem>T13</EnumItem>
                  <EnumItem>T13,5</EnumItem>
                  <EnumItem>T14</EnumItem>
                  <EnumItem>T4</EnumItem>
                  <EnumItem>T5</EnumItem>
                  <EnumItem>T5,5</EnumItem>
                  <EnumItem>T6</EnumItem>
                  <EnumItem>T7</EnumItem>
                  <EnumItem>T7,5</EnumItem>
                  <EnumItem>T8</EnumItem>
                  <EnumItem>T8,5</EnumItem>
                  <EnumItem>T9</EnumItem>
                  <EnumItem>T9,5</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>typeTunnelløp</Name>
         <Definition>Angir hvilken type tunnelløp det er tale om.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_TypeTunnelløp">
                  <EnumItem>Berg</EnumItem>
                  <EnumItem>Berg/løsmasse</EnumItem>
                  <EnumItem>Lokk</EnumItem>
                  <EnumItem>Løsmasse</EnumItem>
                  <EnumItem>Senketunnel</EnumItem>
                  <EnumItem>Dummy</EnumItem>
                  <EnumItem>Dyreundergang</EnumItem>
                  <EnumItem>Rasoverbygg</EnumItem>
                  <EnumItem>Tunnel</EnumItem>
                  <EnumItem>Tunnel, undersjøisk</EnumItem>
                  <EnumItem>Undergang</EnumItem>
                  <EnumItem>Undergang, bru</EnumItem>
                  <EnumItem>Undergang, dyreovergang</EnumItem>
                  <EnumItem>Undergang, ferjekaistag</EnumItem>
                  <EnumItem>Undergang, gangbru</EnumItem>
                  <EnumItem>Undergang, jernbane</EnumItem>
                  <EnumItem>Undergang, kjøreledning</EnumItem>
                  <EnumItem>Undergang, låvebru</EnumItem>
                  <EnumItem>Undergang, veg</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>lengde</Name>
         <Definition>Angir lengde av tunnelløpet. Et tunnelløp sees på som et rør. Eventuelle portaler regnes som del av tunnelløpet. Lengde av tunnelløp blir lik lengde av "røret". Eksempelvis vil lengde av et rampe-løp strekker seg til der rampen kommer inn i hovedløpet selv om rampeparsell kan fortsette et stykke parallelt med hovedvegen i hovedløpet.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcReal"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>arealTverrsnitt</Name>
         <Definition>Angir areal av tunnelløpets tverrsnitt.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcReal"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>bredde</Name>
         <Definition>Angir tunnelløpets minimum bredde målt fra tunnelvegg til tunnelvegg i kjørebanenivå.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcReal"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>høyde</Name>
         <Definition>Angir tunnelløpets minimum høyde målt fra topp kjørebane til tak.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcReal"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>ekstraBelysningInngangssone</Name>
         <Definition>Angir om det er ekstra belysning i tunnelens inngangssoner i forhold til midt inne i tunnelen.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_EkstraBelysningInngangssone">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>malteTunnelvegger</Name>
         <Definition>Angir hvorvidt tunnelvegger er malte eller ikke.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_MalteTunnelvegger">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>årstallForMaling</Name>
         <Definition>Angir hvilket år tunnelveggene sist ble malt.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>brutus_Id</Name>
         <Definition>Gir referanse til brudatabanken.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>merknad</Name>
         <Definition>Permanent merknad til aktuell forekomst.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>åpningsår</Name>
         <Definition>Angir hvilket år tunnelløpet ble åpnet for trafikk.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>oppgraderingsår</Name>
         <Definition>Angir hvilket år tunnelløpet sist var oppgradert iht tunnelsikkerhetsforskriften.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>prosjektreferanse</Name>
         <Definition>Referanse til prosjekt. Det benyttes samme prosjektreferanse som på tilhørende Veganlegg (VT30). Benyttes for lettere å kunne skille nye data fra eksisterende data i NVDB.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>prosjektInternObjekt_ID</Name>
         <Definition>Objektmerking. Unik innenfor tilhørende vegprosjekt.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>VDB_id</Name>
         <Definition>Gir objektets id i VDB</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>utgått_Tunnelklasse</Name>
         <Definition>Angir hvilken tunnelklasse tunnelen er av. Merknad: ET er flyttet til "Tunnel"</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_Utgått_Tunnelklasse">
                  <EnumItem>Kl A</EnumItem>
                  <EnumItem>Kl B</EnumItem>
                  <EnumItem>Kl C</EnumItem>
                  <EnumItem>Kl D</EnumItem>
                  <EnumItem>Kl E</EnumItem>
                  <EnumItem>Kl E1</EnumItem>
                  <EnumItem>Kl E2</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedlikeholdsansvarlig</Name>
         <Definition>Utgår: Gir info om vedlikeholdsansvarlig, f.eks navn, adresse, telefon, etc</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>vedlikeholdsavtale</Name>
         <Definition>Gir referanse til evt. Vedlikeholdsavtale</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>interntNummer</Name>
         <Definition>Angir nummer/kortnavn på tunnelløp.</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcText"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>omkjøringsmulighet</Name>
         <Definition>Angir om trafikken kan omdirigeres når tunnel/undergang er stengt.</Definition>
         <PropertyType>
            <TypePropertyEnumeratedValue>
               <EnumList name="PEnum_Tunnelløp_Omkjøringsmulighet">
                  <EnumItem>Ja</EnumItem>
                  <EnumItem>Nei</EnumItem>
               </EnumList>
            </TypePropertyEnumeratedValue>
         </PropertyType>
      </PropertyDef>
      <PropertyDef>
         <Name>volum</Name>
         <Definition>Angir volum av vegobjektet</Definition>
         <PropertyType>
            <TypePropertySingleValue>
               <DataType type="IfcInteger"/>
            </TypePropertySingleValue>
         </PropertyType>
      </PropertyDef>
   </PropertyDefs>
</PropertySetDef>
