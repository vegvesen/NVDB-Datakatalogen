### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et10702
:et10702 rdf:type owl:ObjectProperty ;
		rdfs:subPropertyOf :et_o_vot886 ;
		rdfs:domain :vot886;
		rdfs:range :kl10702;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 10702 ;
		:nvdb_navn "Nivå"@no ;
		rdfs:label "Nivå"@no ;
		:sosi_navn "nivå"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Angir om det er lokal eller overordnet omkjøringsrute. Lokale kontra overordna går på om en omkjøringsrute er beregnet for å hovedsakelig ta seg av lokaltrafikk eller om den også kan ta gjennomgangstrafikken. Lokale o. er beregna for å ta lokal trafikk, overordna o. er beregna for gjennomgangstrafikk og fanger gjerne opp trafikken et godt stykke før aktuell stengningslenke. Se også Håndbok R611 kap. 7.4."@no .


:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10702;
		owl:onClass :kl10702;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10702;
		owl:allValuesFrom :kl10702;
		] .


