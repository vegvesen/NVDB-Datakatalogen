:kl13041 rdf:type owl:Class ;
		rdfs:subClassOf :kl_vot793 ;
		:nvdb_id 13041 ;
		:nvdb_navn "NVDB dokumentasjon"@no ;
		rdfs:label "NVDB dokumentasjon (NVDB dokumentasjon)"@no ;
		:sosi_navn "HREFStyringsparameterNVDB dokumentasjon"@no ;
		skos:definition "Styringsparameter HREF i Datakatalogen for å styre bruk av HREF på geometriegenskapstyper. Det vil av tillatte verdier framkomme mulige verdier for HREF i Datakatalogen. Styringsparameteren benevnes \"Høydereferanse_tall\" i NVDB API Les."@no .

