:tv5117 rdf:type :kl4134, skos:Concept ;
		skos:inScheme :kl4134CS ;
		:nvdb_id 5117 ;
		:nvdb_navn "Allé"@no ;
		rdfs:label "Allé"@no ;
		:sosi_navn "Allé"@no ;
		:kortnavn "al" ;
		skos:definition "Tre inngår i en allé. Allé er regelmessige rekker av trær på hver sin side av en veg, gate eller gangsti."@no .


