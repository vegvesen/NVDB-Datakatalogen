### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv21920
:tv21920 rdf:type :kl11415, skos:Concept ;
		skos:inScheme :kl11415CS ;
		:nvdb_id 21920 ;
		:nvdb_navn "Jorddekkemiddel, kompost/bark"@no ;
		rdfs:label "Jorddekkemiddel, kompost/bark"@no ;
		:sosi_navn "Jorddekkemiddel, kompost/bark"@no ;
		:kortnavn "JK" ;
		skos:definition "Dekkmaterialet legges ut på jord, fri for ugras, lagtykkelse skal holdes på 8-10 cm. Dekkmaterialet skal ikke ligge inntil stammebark eller rothals på planten. Utlegging skal skje på en slik måte at jordstruktur og planter ikke skades av arbeidet."@no .


