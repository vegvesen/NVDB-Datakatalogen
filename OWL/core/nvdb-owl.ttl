:vot1012 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 1012 ;
		:nvdb_navn "Beredskapsnivå (test)"@no ;
		rdfs:label "Beredskapsnivå (test)"@no ;
		:sosi_navn "NVDB_BEREDSKAPSNIVÅ_TEST"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan ikke gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Strekning."@no ;
		skos:definition "Angir hvilket beredskapsnivå det er på vegstrekningen.  Nivåsetting som metode skal bidra til at veier åpnes raskere etter hendelser som lager blokkering/stans på veinettet over tid. Beredskapsnivå for en vegstrekning fastsettes av vegeier i samråd med Politiet ut fra vurderinger knyttet til:  1. Hvor høy trafikktetthet det er på strekningen. 2. Hvor viktig strekningen er for fremkommelighet for kritisk transport. 3. Hvilke muligheter som finnes for omkjøring. 4. Hvor egnet aktuelle omkjøringsruter er."@no .


