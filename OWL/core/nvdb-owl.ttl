### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et5641
:et5641 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot461 ;
		rdfs:domain :vot461;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 5641 ;
		:nvdb_navn "Målernummer"@no ;
		rdfs:label "Målernummer"@no ;
		:sosi_navn "målernummer"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Angir unikt målernummer for måleren. Nummer må endres om måler blir byttet. Merknad: For Statens vegvesen blir dette feltet oppdatert fra Elhub dersom MålepunktID er fylt ut korrekt."@no .


:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et5641;
		owl:onDataRange xsd:string;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et5641;
		owl:allValuesFrom xsd:string;
		] .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et5642
:et5642 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot461 ;
		rdfs:domain :vot461;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 5642 ;
		:nvdb_navn "MålepunktID"@no ;
		rdfs:label "MålepunktID"@no ;
		:sosi_navn "målepunktID"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Angir MålepunktID. Energibedriftenes Landsforening (EBL) og EAN NORGE har inngått en rammeavtale om innføring av standard nummerserier for målepunktidentifikasjon. Denne standarden kalles Global Service Relation Number (GSRN). Feltet skal fylles ut med 18 sifre. 
For Statens vegvesen er dette nøkkelfelt mot Elhub."@no .


:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et5642;
		owl:onDataRange xsd:string;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et5642;
		owl:allValuesFrom xsd:string;
		] .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12062
:et12062 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot461 ;
		rdfs:domain :vot461;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12062 ;
		:nvdb_navn "Anleggsadresse"@no ;
		rdfs:label "Anleggsadresse"@no ;
		:sosi_navn "anleggsadresse"@no ;
		:viktighet "Betinget"@no ;
		skos:definition "Angir navn/adresse på elektrisk anlegg. Merknad: For SVV blir dette feltet oppdatert fra Elhub dersom det ikke er angitt noen informasjon i NVDB og MålepunktID er fylt ut korrekt."@no .


:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12062;
		owl:onDataRange xsd:string;
		owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot461 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12062;
		owl:allValuesFrom xsd:string;
		] .


