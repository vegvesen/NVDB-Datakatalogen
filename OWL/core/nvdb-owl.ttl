### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12848
:et12848 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot874 ;
		rdfs:domain :vot874;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12848 ;
		:nvdb_navn "Tilstandsindikator (test)"@no ;
		rdfs:label "Tilstandsindikator (test)"@no ;
		:sosi_navn "tilstandsindikator_Test"@no ;
		:viktighet "Opsjonell"@no ;
		:desimaler 0;
		skos:definition "Tilstandsindikator for gående og syklende.  Baserer seg på hvor god løsning det tilbys for syklende på strekningen sammenlignet med krav i vegnormalene. Metode er under utvikling. Foreløpig klassifisering: 0: God - Tilfredsstiller krav. 1: Middels - Ligger noe under krav. 2: Dårlig - Ligger vesentlig under krav. 3: Svært dårlig - Ligger svært mye under krav. 98: Mangler data. 99: Utenfor utvalg av veger."@no .


