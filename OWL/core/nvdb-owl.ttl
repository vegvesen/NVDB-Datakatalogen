:tv23099 rdf:type :kl13203, skos:Concept ;
		skos:inScheme :kl13203CS ;
		:nvdb_id 23099 ;
		:nvdb_navn "Annen"@no ;
		rdfs:label "Annen"@no ;
		:sosi_navn "Annen"@no ;
		:kortnavn "A" ;
		skos:definition "Blomsterbeplanting som har annet skjøtselsnivå enn parkskjøtsel jfr. R610 eller tilsvarende standard."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv23098
:tv23098 rdf:type :kl13203, skos:Concept ;
		skos:inScheme :kl13203CS ;
		:nvdb_id 23098 ;
		:nvdb_navn "Naturskjøtsel"@no ;
		rdfs:label "Naturskjøtsel"@no ;
		:sosi_navn "Naturskjøtsel"@no ;
		:kortnavn "N" ;
		skos:definition "Ikke aktuelt for blomsterbeplanting langs veger som skjøttes etter krav gitt i R610."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv23097
:tv23097 rdf:type :kl13203, skos:Concept ;
		skos:inScheme :kl13203CS ;
		:nvdb_id 23097 ;
		:nvdb_navn "Parkskjøtsel"@no ;
		rdfs:label "Parkskjøtsel"@no ;
		:sosi_navn "Parkskjøtsel"@no ;
		:kortnavn "P" ;
		skos:definition "Blomsterbeplanting med parkskjøtsel er ofte tilknyttet veger og gater i/ved byer og tettsteder, men det kan også gjelde rasteplasser, holdeplasser, lommer, rundkjøringer og kryssområder. Skjøtsel omfatter vanning, gjødsling, ugrashåndtering, opprettholdelse av jorddekkemiddel, beskjæring, fjerning/ supplering av døde planter, håndtering av sykdommer og skadedyr, oppfølging av oppbindings- og klatreobjekt. For skjøtselsbeskrivelse, se R610 eller tilsvarende standard/ beskrivelse."@no .


