### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv23102
:tv23102 rdf:type :kl13204, skos:Concept ;
		skos:inScheme :kl13204CS ;
		:nvdb_id 23102 ;
		:nvdb_navn "Annen"@no ;
		rdfs:label "Annen"@no ;
		:sosi_navn "Annen"@no ;
		:kortnavn "A" ;
		skos:definition "Grasdekke som har annet skjøtselsnivå enn parkskjøtsel eller naturskjøtsel jfr. R610 eller tilsvarende standard."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv23101
:tv23101 rdf:type :kl13204, skos:Concept ;
		skos:inScheme :kl13204CS ;
		:nvdb_id 23101 ;
		:nvdb_navn "Naturskjøtsel"@no ;
		rdfs:label "Naturskjøtsel"@no ;
		:sosi_navn "Naturskjøtsel"@no ;
		:kortnavn "N" ;
		skos:definition "Grasdekke med naturskjøtsel eng eller grasbakke som klippes 1-2 ganger i sesongen. Grasdekke med naturskjøtsel er ofte tilknyttet landlige veger. Det kan også gjelde rasteplasser, holdeplasser, lommer, rundkjøringer og kryssområder som er opparbeidet, men som ikke krever så intensiv skjøtsel. For skjøtselsbeskrivelse, se R610, eller tilsvarende standard/ beskrivelse."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv23100
:tv23100 rdf:type :kl13204, skos:Concept ;
		skos:inScheme :kl13204CS ;
		:nvdb_id 23100 ;
		:nvdb_navn "Parkskjøtsel"@no ;
		rdfs:label "Parkskjøtsel"@no ;
		:sosi_navn "Parkskjøtsel"@no ;
		:kortnavn "P" ;
		skos:definition "Grasdekke med parkskjøtsel er plen eller grasbakke som klippes 3 ganger eller oftere i sesongen. Grasdekke skal se velstelt ut. Grasdekke med parkskjøtsel er ofte tilknyttet veger og gater i/ved byer og tettsteder, men det kan også gjelde rasteplasser, holdeplasser, lommer, rundkjøringer og kryssområder. For skjøtselsbeskrivelse, se R610, eller tilsvarende standard/ beskrivelse"@no .


:kl13204 owl:oneOf (
		:tv23102
		:tv23101
		:tv23100
	) ; .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl12559
:kl12559 rdf:type owl:Class ;
		rdfs:subClassOf :kl_vot15 ;
		:nvdb_id 12559 ;
		:nvdb_navn "Grasdekker"@no ;
		rdfs:label "Grasdekker (Grasdekker)"@no ;
		:sosi_navn "SpesielleHensynGrasdekker"@no ;
		skos:definition "Angir om det skal tas spesielle hensyn ved skjøtsel. Dette kan for eksempel være om det er satt ned blomsterløk i grasdekket, eller om det er fremmede skadelige arter som ikke kan klippes (slirekne-artene). Dette beskrives i «Tilleggsinformasjon»."@no .

