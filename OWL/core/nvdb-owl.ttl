### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl12985
:kl12985 rdf:type owl:Class ;
		rdfs:subClassOf :kl_vot487 ;
		:nvdb_id 12985 ;
		:nvdb_navn "Holdeplassutrustning"@no ;
		rdfs:label "Holdeplassutrustning (Holdeplassutrustning)"@no ;
		:sosi_navn "TilrettelagtForOmstigningBytteHoldeplassutrustning"@no ;
		skos:definition "Det er lagt opp til at reisende her skal kunne bytte mellom ulike kollektivlinjer, og det er gjerne satt opp linjer som korresponderer. Det kan gjelde omstigning til/fra vegbasert kollektivtrafikk, men også til/fra tog, fly, båt og ferje."@no .

### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl12985CS
:kl12985CS a skos:ConceptScheme ;
		rdfs:label "Konseptskjema Holdeplassutrustning (Holdeplassutrustning)"@no ;
		skos:definition "Det er lagt opp til at reisende her skal kunne bytte mellom ulike kollektivlinjer, og det er gjerne satt opp linjer som korresponderer. Det kan gjelde omstigning til/fra vegbasert kollektivtrafikk, men også til/fra tog, fly, båt og ferje."@no ;
		dc:isFormatOf :kl12985 .

### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv22554
:tv22554 rdf:type :kl12985, skos:Concept ;
		skos:inScheme :kl12985CS ;
		:nvdb_id 22554 ;
		:nvdb_navn "Nei"@no ;
		rdfs:label "Nei"@no ;
		:sosi_navn "Nei"@no ;
		:kortnavn "N" ;
		skos:definition "Det kan være mulig å bytte mellom ulike busslinjer, men det er ingen spesiell tilrettelegging, dvs ingen planlagt korrespondanse."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv22553
:tv22553 rdf:type :kl12985, skos:Concept ;
		skos:inScheme :kl12985CS ;
		:nvdb_id 22553 ;
		:nvdb_navn "Omstigningsholdeplass"@no ;
