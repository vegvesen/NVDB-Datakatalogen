### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#vot67
:vot67 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 67 ;
		:nvdb_navn "Tunnelløp"@no ;
		rdfs:label "Tunnelløp"@no ;
		:sosi_navn "NVDB_TUNNELLØP"@no ;
		:kjørefeltRelevant "Kan gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Strekning."@no ;
		skos:definition "Utgravd eller utstøpt passasje gjennom jord/berg eller under større lokk. Har normalt inngang og utgang i dagen. I spesielle tilfeller, f.eks. når forgreninger eller kryss, kan det være utgang mot annet tunnelløp eller inngang fra annet tunnelløp. Se også Undergang, Skredoverbygg og Høydebegrensning."@no .


