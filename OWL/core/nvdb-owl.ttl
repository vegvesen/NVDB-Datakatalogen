:vot301 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 301 ;
		:nvdb_navn "Kantklippareal"@no ;
		rdfs:label "Kantklippareal"@no ;
		:sosi_navn "NVDB_KANTKLIPPAREAL"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Strekning."@no ;
		skos:definition "Angir område med vegetasjon langs vegkant/skråning. Dette er vanligvis vegetasjon som skal skjøttes vha kantklipper (kantslått). Det er mulig å gi bredde i form av tilkopla \"breddemåling\"."@no .


