### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12690
:et12690 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot983 ;
		rdfs:domain :vot983;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12690 ;
		:nvdb_navn "Tilstandsindikatorverdi"@no ;
		rdfs:label "Tilstandsindikatorverdi"@no ;
		:sosi_navn "tilstandsindikatorverdi"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		:desimaler 0;
		skos:definition "Tilstandsindikator for bæreevne. Baseres på kontinuerlige nedbøyningsmålinger med Rapid Pavement Tester (Raptor) og strekningsbæreevne som 10-persentil for PMS-parseller (opptil 1000 m). Tilstand angis med verdi fra 0 til 3, samt 98 og 99. 0: Ingen avvik - B (bæreevne) > 16 tonn. 1: Mindre eller moderate avvik - 14 tonn < B ≤  16 tonn. 2: Vesentlig avvik - 10 tonn < B ≤  14 tonn. 3: Stort eller alvorlig avvik - B ≤  10 tonn. 98: Mangler data. 99: Utenfor utvalg av veger."@no .


:vot983 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12690;
		owl:onDataRange xsd:integer;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot983 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12690;
		owl:allValuesFrom xsd:integer;
		] .


