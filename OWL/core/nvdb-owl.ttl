### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et10700
:et10700 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot886 ;
		rdfs:domain :vot886;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 10700 ;
		:nvdb_navn "Strekningsnavn"@no ;
		rdfs:label "Strekningsnavn"@no ;
		:sosi_navn "strekningsnavn"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Navn på omkjøringsrute. Merknad: Navn skal settes sammen av stedsnavn/kryssnavn ved start og slutt på omkjøringsruta, fortrinnsvis samme navn som benyttes på aktuelle stengningslenker, i tillegg kan det tas med navn på sted eller vegnummer som ruta går via. Navn skal angis i samme rekkefølge som på stengningslenke, med unntak av omkjøringsruter som kun gjelder omkjøring mot stengningslenkens retning. Eksempel på navn på omkjøringsrute \"Hommelvik - Værnes, via FV 950\".Det skal angis tydelige og beskrivende navn med tanke på at navn også skal benyttes ved trafikkinformasjon."@no .


:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10700;
		owl:onDataRange xsd:string;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10700;
		owl:allValuesFrom xsd:string;
		] .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et10797
:et10797 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot886 ;
		rdfs:domain :vot886;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 10797 ;
		:nvdb_navn "Omkjøring for veg"@no ;
		rdfs:label "Omkjøring for veg"@no ;
		:sosi_navn "omkjøringForVeg"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Angir hvilken veg omkjøringsruta er omkjøringsrute for. Angis med vegkategori-vegstatus-vegnummer, f.eks. RV9, EV6 osv. (0-er foran i vegnummer skal ikke angis). Gatenavn kan angis om det er snakk om omkjøringsrute for gater/kommunale veger. Om ulik veg ved start og slutt skal veg ved start angis."@no .


:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10797;
		owl:onDataRange xsd:string;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot886 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et10797;
		owl:allValuesFrom xsd:string;
		] .


