:tv5119 rdf:type :kl4160, skos:Concept ;
		skos:inScheme :kl4160CS ;
		:nvdb_id 5119 ;
		:nvdb_navn "Løvfellende"@no ;
		rdfs:label "Løvfellende"@no ;
		:sosi_navn "Løvfellende"@no ;
		:kortnavn "l" ;
		skos:definition "Løvfellende trær har flate og tynne blader og hører til den botaniske underavdelingen Magnoliophýtina (dekkfrøete planter)."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv5120
:tv5120 rdf:type :kl4160, skos:Concept ;
		skos:inScheme :kl4160CS ;
		:nvdb_id 5120 ;
		:nvdb_navn "Vintergrønne"@no ;
