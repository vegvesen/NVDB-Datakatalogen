### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12693
:et12693 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot984 ;
		rdfs:domain :vot984;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
