:et12228 rdf:type owl:ObjectProperty ;
		rdfs:subPropertyOf :et_o_vot107 ;
		rdfs:domain :vot107;
		rdfs:range :kl12228;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12228 ;
		:nvdb_navn "Fjellovergang"@no ;
		rdfs:label "Fjellovergang"@no ;
		:sosi_navn "fjellovergang"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		skos:definition "Angir om værutsatt veg regnes som en offisiell fjellovergang. Fjelloverganger er lengre strekninger utenfor bebyggelse som er særlig utsatt for stengning og problemer på vinterstid pga. snø og dårlig vær. Hoveddelen av en fjellovergang ligger over tregrensa. Værutsatte veger som ikke regnes som offisielle fjelloverganger er gjerne korte, har lite trafikk og mangler utrustning som bommer etc."@no .


