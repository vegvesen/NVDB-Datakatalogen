### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#vot1013
:vot1013 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 1013 ;
		:nvdb_navn "Fiskepassasje"@no ;
		rdfs:label "Fiskepassasje"@no ;
		:sosi_navn "NVDB_FISKEPASSASJE"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Punkt."@no ;
		skos:definition "Alle stikkrenner, kulverter og bruer hvor fisken burde kunne passere, uavhengig av om det faktisk skjer. Stikkrenner, kulvert og bruer er typiske tiltak som har primærfunksjon knyttet til vannhåndtering, men som samtidig har sekundærfunksjon som fiskepassasje. Fiskepassasjer kan ha egne tiltak i form av feks vannspeil, kulper, terskler og fisketrapper og som krever særskilt drift og vedlikehold. Driften og vedlikeholdet av fiskepassasjer skal ivareta frie vandringsveger for både fisk og andre ferkvannssorganismer med egen evne til vandring."@no .


