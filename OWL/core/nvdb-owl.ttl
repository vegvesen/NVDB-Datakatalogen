### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12687
:et12687 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot982 ;
		rdfs:domain :vot982;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12687 ;
		:nvdb_navn "Tilstandsindikatorverdi"@no ;
		rdfs:label "Tilstandsindikatorverdi"@no ;
		:sosi_navn "tilstandsindikatorverdi"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		:desimaler 0;
		skos:definition "Tilstandsindikator for dekkebredde. Baserer seg på registrert dekkebredde og sammenlignes med krav til bredde med fast dekke i tverrprofilet for respektive dimensjoneringsklasse i N100. Tilstand angis med verdi fra 0 til 3, samt 98 og 99. 0: Ingen avvik - Tilfredsstiller krav. 1: Mindre eller moderate avvik. Avvik er mindre enn krav til neste dimensjoneringsklasse eller utbedringsstandard for aktuell dimensjoneringsklasse. 2: Vesentlig avvik - Avvik i størrelsesorden mellom en og to dimensjoneringsklasser under krav. For H3 er krav satt til minste bredde basert på bygd praksis (16,5 m) for firfeltsveg. 3: Stort eller alvorlig avvik - Avvik er minst to dimensjoneringsklasser under krav, for H3 er bredden under 16,5 m. 98: Mangler data. 99: Utenfor foreløpig utvalg av veger."@no .


:vot982 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12687;
		owl:onDataRange xsd:integer;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot982 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12687;
		owl:allValuesFrom xsd:integer;
		] .


