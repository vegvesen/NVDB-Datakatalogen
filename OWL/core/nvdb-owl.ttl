### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl4594
:kl4594 rdf:type owl:Class ;
		rdfs:subClassOf :kl_vot83 ;
		:nvdb_id 4594 ;
		:nvdb_navn "Kum"@no ;
		rdfs:label "Kum (Kum)"@no ;
		:sosi_navn "DykkerKum"@no ;
		skos:definition "Angir om det er dykker i tilknytning til kummen. Dykker er en konstruksjon som skal hindre slitasje på kummen når det føres mye vann inn i kummen på et nivå høyere enn bunnen på kummen. Dykker kan også brukes for å føre inn en slange med vann eller damp for tining av frosne kummer eller ledninger."@no .

