### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12976
:et12976 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot998 ;
		rdfs:domain :vot998;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12976 ;
		:nvdb_navn "Tilstandsindikatorverdi"@no ;
		rdfs:label "Tilstandsindikatorverdi"@no ;
		:sosi_navn "tilstandsindikatorverdi"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		:desimaler 0;
		skos:definition "Tilstandsindikator for bru. Baserer seg på hvilke trafikklaster bruas bæreevne er godkjent for. Tilstand angis med verdi 0 til 3. 0: Ingen avvik: Brua er godkjent for bruksklasse Bk10/60, Sv 12/65 og Sv 12/100. 1: Mindre eller moderate avvik - Brua er godkjent for bruksklasse Bk10/60, Sv 12/65 og Sv 12/100 med restriksjon. 2: Vesentlig avvik - Brua er godkjent for  Bk10/60 og Sv 12/100 med restriksjon. 3: Stort eller alvorlig avvik - brua er ikke godkjent for  Bk10/60, Sv 12/65 og Sv 12/100, eller merket med veggruppe \"ikke\". 98: Mangler data. 99: Utenfor utvalg av veger."@no .


:vot998 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12976;
		owl:onDataRange xsd:integer;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot998 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12976;
		owl:allValuesFrom xsd:integer;
		] .


