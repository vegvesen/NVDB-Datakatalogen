### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et5174
:et5174 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot580 ;
		rdfs:domain :vot580;
		rdfs:range xsd:string;
