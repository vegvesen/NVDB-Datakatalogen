### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv5115
:tv5115 rdf:type :kl4134, skos:Concept ;
		skos:inScheme :kl4134CS ;
		:nvdb_id 5115 ;
		:nvdb_navn "Tregruppe"@no ;
		rdfs:label "Tregruppe"@no ;
		:sosi_navn "Tregruppe"@no ;
		:kortnavn "tg" ;
		skos:definition "Tre inngår i en tregruppe. Tregruppe består av minst 3 trær som står med relativ nærhet til hverandre. Gruppen skal ikke være særlig bredere enn høyden på trærne."@no .


