### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#vot461
:vot461 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 461 ;
		:nvdb_navn "Elektrisk anlegg"@no ;
		rdfs:label "Elektrisk anlegg"@no ;
		:sosi_navn "NVDB_ELEKTRISKANLEGG"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Punkt."@no ;
		skos:definition "Matepunkt med måler for lavspentnett som forsyner vegeiers installasjoner med strøm. Merknad: Et elektrisk anlegg skal alltid ha en forekomst av \"Fordeling\" (VT 819) knyttet til seg."@no .


