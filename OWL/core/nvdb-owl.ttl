### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#vot20
:vot20 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 20 ;
		:nvdb_navn "KantstolperRefleks"@no ;
		rdfs:label "KantstolperRefleks"@no ;
		:sosi_navn "NVDB_KANTSTOLPERREFLEKS"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Strekning."@no ;
		skos:definition "Stolper - f.eks. forsynt med lysreflekterende materiale - som markerer vegkanten og gir en optisk ledning langs vegen (1). Kan også være refleks festa på rekkverk eller på dobber som henger i tunneltak. I noen tilfeller brukes det også ifm. midtdelere. Merknad: Det skal registreres separate forekomster av kantstolper/refleks for hver side av vegen."@no .


