:vot964 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 964 ;
		:nvdb_navn "Brenselcelle"@no ;
		rdfs:label "Brenselcelle"@no ;
		:sosi_navn "NVDB_BRENSELCELLE"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Punkt."@no ;
		skos:definition "Enhet som lager elektrisk energi fra et drivstoff ved å la det reagere med oksygen ved hjelp av et oksidasjonsmiddel i en elektrokjemisk prosess. Drivstoffet er vanligvis hydrogen eller naturgass, men andre hydrokarboner og alkoholer kan også benyttes, f.eks. propan, LPG, metanol eller biogass. Som oksidasjonsmiddel brukes oftest oksygen."@no .


