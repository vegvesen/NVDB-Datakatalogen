		:nvdb_navn "Lengde, offisiell"@no ;
		rdfs:label "Lengde, offisiell"@no ;
		:sosi_navn "lengde_Offisiell"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		:desimaler 0;
		:enhet "Meter"@no ;
		skos:definition "Angir tunnelens offisielle lengde. Lengde skal oppgis i henhold til regelverk for skilting. Dvs. at for tunneler opp til 1000 m avrundes lengde til nærmeste 10 meter, for tunneler over 1000 meter avrundes lengde til nærmeste 100 meter (jfr. Håndbok N300). For tunneler med flere løp tas det utgangspunkt i lengste hovedløp. Denne lengden skal registreres uavhengig av om tunnellengde er skiltet eller ikke."@no .


:vot581 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et8945;
		owl:onDataRange xsd:integer;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot581 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et8945;
		owl:allValuesFrom xsd:integer;
		] .


