	) ; .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl10671
:kl10671 rdf:type owl:Class ;
		rdfs:subClassOf :kl_vot199 ;
		:nvdb_id 10671 ;
		:nvdb_navn "Trær"@no ;
		rdfs:label "Trær (Trær)"@no ;
		:sosi_navn "NaturlikeVerdifulleTrærTrær"@no ;
		skos:definition "Angis for naturlike trær som skal tas spesielt hensyn til. Naturlike trær som er hule grove inngår her under biologisk verdi. Kontroll og skjøtsel utdypes under \"Tilleggsinformasjon\". Hvis treet kan ha flere verdier velges den verdien som er mest fremtredende for treet."@no .

### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#kl10671CS
:kl10671CS a skos:ConceptScheme ;
		rdfs:label "Konseptskjema Trær (Trær)"@no ;
		skos:definition "Angis for naturlike trær som skal tas spesielt hensyn til. Naturlike trær som er hule grove inngår her under biologisk verdi. Kontroll og skjøtsel utdypes under \"Tilleggsinformasjon\". Hvis treet kan ha flere verdier velges den verdien som er mest fremtredende for treet."@no ;
		dc:isFormatOf :kl10671 .

### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv17229
:tv17229 rdf:type :kl10671, skos:Concept ;
		skos:inScheme :kl10671CS ;
		:nvdb_id 17229 ;
		:nvdb_navn "Biologisk"@no ;
		rdfs:label "Biologisk"@no ;
		:sosi_navn "Biologisk"@no ;
		:kortnavn "B" ;
		skos:definition "Treet har hulrom og tørr vedmold, minst noen partier med dødved. Grove hule eiker (jf.forskriften) og ask inngår her."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv17228
:tv17228 rdf:type :kl10671, skos:Concept ;
		skos:inScheme :kl10671CS ;
		:nvdb_id 17228 ;
		:nvdb_navn "Estetisk"@no ;
		rdfs:label "Estetisk"@no ;
		:sosi_navn "Estetisk"@no ;
		:kortnavn "E" ;
		skos:definition "Treet er vakkert og står som et viktig landskapselement, gjerne landemerke. Treet er ofte solitært, men kan også være en del av alle eller trerekke."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv17230
:tv17230 rdf:type :kl10671, skos:Concept ;
		skos:inScheme :kl10671CS ;
		:nvdb_id 17230 ;
		:nvdb_navn "Kulturhistorisk"@no ;
		rdfs:label "Kulturhistorisk"@no ;
		:sosi_navn "Kulturhistorisk"@no ;
		:kortnavn "K" ;
		skos:definition "Treet står i tilknytning til en gård eller historisk anlegg. Kan være registrert som kulturminne. Ofte solitære, m en kan også inngå i trerekke."@no .


:kl10671 owl:oneOf (
		:tv17229
		:tv17228
		:tv17230
	) ; .


