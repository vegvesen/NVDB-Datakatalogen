:vot39 rdf:type owl:Class ;
		rdfs:subClassOf :Vegobjekttype ;
		:nvdb_id 39 ;
		:nvdb_navn "Rasteplass"@no ;
		rdfs:label "Rasteplass"@no ;
		:sosi_navn "NVDB_RASTEPLASS"@no ;
		:kjørefeltRelevant "Kan ikke gi feltkode."@no ;
		:sideposisjonRelevant "Kan gi sideposisjon."@no ;
		:retningsRelevant "ikke retningsrelevant."@no ;
		:stedfestingstype "Strekning."@no ;
		skos:definition "Sted ved vegen der vegtrafikanter kan parkere og hvile. En rasteplass skal ha direkte tilknytning til vegen, være adskilt fra kjørebanen med rekkverk eller grøntareal og minimum være utstyrt med flere bord og avfallsdunk (jfr. kriterier for skilting av rasteplass). Rasteplasser som registreres i  NVDB skal være skiltet med skiltnummer 613."@no .


