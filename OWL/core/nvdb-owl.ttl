### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12765
:et12765 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot581 ;
		rdfs:domain :vot581;
		rdfs:range xsd:string;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12765 ;
		:nvdb_navn "Driftsmerking TFM, lokasjonskode"@no ;
		rdfs:label "Driftsmerking TFM, lokasjonskode"@no ;
		:sosi_navn "driftsmerkingTFM_Lokasjonskode"@no ;
		:viktighet "Betinget"@no ;
		skos:definition "Tverrfaglig merkesystem (TFM) lokasjonskode som skal benyttes i driftsmerking for tunnelen. Denne lokasjonskoden skal utgjøre første del av driftsmerkingen til de enkelte vegobjektene i tunnelen. Merkingen skal være bygd opp slik: ABBCCDDD der A angir anleggseier (S=Statens vegvesen, N=Nye Veier AS, F=Fylkeskommune, O=OPS-selskap og K=Kommune), BB er fylkesnummer, CC er anleggskode (denne skal være TU for tunnel) og DDD er trebokstavskode for tunnelen. Det skal i legges til + foran teksten når den benyttes i driftsmerking."@no .


:vot581 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12765;
		owl:onDataRange xsd:string;
		owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot581 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12765;
		owl:allValuesFrom xsd:string;
		] .


