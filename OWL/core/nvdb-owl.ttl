### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#et12696
:et12696 rdf:type owl:DatatypeProperty ;
		rdfs:subPropertyOf :et_d_vot985 ;
		rdfs:domain :vot985;
		rdfs:range xsd:integer;
		rdf:type owl:FunctionalProperty;
		:nvdb_id 12696 ;
		:nvdb_navn "Tilstandsindikatorverdi"@no ;
		rdfs:label "Tilstandsindikatorverdi"@no ;
		:sosi_navn "tilstandsindikatorverdi"@no ;
		:viktighet "Påkrevd ved nyregistrering"@no ;
		:desimaler 0;
		skos:definition "Tilstandsindikator for vertikalkurvatur. Baserer seg på registert radius for høy- og lavbrekk samt stigning på rettstrekninger sammenlignet med krav for respektive dimensjoneringsklasse i N100. Tilstand angis med verdi fra 0 til 3, samt 98 og 99. Prinsippene for klassifisering er: 0: Ingen avvik - Tilfredsstiller krav. 1: Mindre eller moderate avvik, tilsvarende maks 5 km/t fartsreduksjon ved beregning av krav med aktuelt formelverk. 2: Vesentlig avvik -  tilsvarende maks 10 km/t fartsreduksjon ved beregning av krav med aktuelt formelverk. 3: Stort eller alvorlig avvik -  tilsvarende over 10 km/t fartsreduksjon ved beregning av krav med aktuelt formelverk. 98: Mangler data. 99: Utenfor utvalg av veger."@no .


:vot985 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12696;
		owl:onDataRange xsd:integer;
		owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
		] .
:vot985 rdfs:subClassOf [ rdf:type owl:Restriction ;
		owl:onProperty :et12696;
		owl:allValuesFrom xsd:integer;
		] .


