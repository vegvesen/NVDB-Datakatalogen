		rdfs:label "Skog/tregruppe"@no ;
		:sosi_navn "Skog/tregruppe"@no ;
		:kortnavn "skg" ;
		skos:definition "En gruppe eller samling trær med undervegetasjon som skal tynnes/ ryddes jevnlig for å åpne for inn- og utsyn. Består av store eller små trær, med bunnvegetasjon av gress, urter eller lavtvoksende busk-kratt."@no .


### https://ontologi.atlas.vegvesen.no/nvdb/core/nvdb-owl#tv16945
:tv16945 rdf:type :kl10565, skos:Concept ;
		skos:inScheme :kl10565CS ;
